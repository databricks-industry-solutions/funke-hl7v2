# Example environment file for local development of the funke control-room app.
# Copy to `.env` (gitignored) and fill in your own values. `.envrc` loads it via direnv.

# Databricks workspace auth for the SDK WorkspaceClient (local dev only; on Databricks
# Apps these are provided automatically). Alternatively configure a CLI profile instead.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-personal-access-token>

# Unity Catalog landing volume the app reads/writes; the catalog and schema are parsed
# from this path (/Volumes/<catalog>/<schema>/<volume>).
LANDING_VOLUME_PATH=/Volumes/main/hl7/landing

# SQL warehouse backing the census/flow queries and the bed-utilization dashboard.
DATABRICKS_WAREHOUSE_ID=<your-sql-warehouse-id>

# Optional: override the embedded dashboard URL shown in the app's Dashboard tab.
# DASHBOARD_URL=

# Optional: local port for the app (defaults to 8000).
# DATABRICKS_APP_PORT=8000
