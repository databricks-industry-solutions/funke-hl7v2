# direnv configuration for funke. Run `direnv allow` once after cloning.

# Activate the project virtualenv (create one via layout python if it doesn't exist yet).
if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
else
    layout python python3
fi

# Pin Java 17 for PySpark (Spark 4.x doesn't support newer JDKs; a too-new JDK
# fails with ClassNotFoundException: jdk.internal.ref.Cleaner). No-op if the
# java_home helper or a matching JDK isn't available.
if command -v /usr/libexec/java_home >/dev/null 2>&1; then
    _java17="$(/usr/libexec/java_home -v 17 2>/dev/null)"
    if [ -n "$_java17" ]; then
        export JAVA_HOME="$_java17"
        PATH_add "$JAVA_HOME/bin"
    fi
    unset _java17
fi

# Load local environment variables (.env is gitignored and holds secrets).
dotenv
